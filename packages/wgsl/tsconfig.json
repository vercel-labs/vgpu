{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    // Keep optional adapter types outside the project graph; emitted imports stay unchanged.
    "paths": {
      "@vgpu/adapter-node": ["./src/runtime/adapter-node-ambient.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"]
}
