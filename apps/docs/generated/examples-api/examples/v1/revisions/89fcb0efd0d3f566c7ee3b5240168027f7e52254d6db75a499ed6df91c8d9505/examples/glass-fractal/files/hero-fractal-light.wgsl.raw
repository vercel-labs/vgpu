// One coherent key light for both the ceramic BRDF and the baked floor shadow.
// Keeping the position here makes it impossible for those two cues to drift.
export const HERO_KEY_LIGHT_POSITION = vec3f(0.4, 3.6, 3.0);
export const HERO_KEY_LIGHT_COLOR = vec3f(1.0, 0.94, 0.86);
export const HERO_KEY_LIGHT_RADIUS = 0.58;
