{
  "name": "docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/prepare-ort-assets.mjs && node scripts/prepare-depth-models.mjs && node scripts/ingest-examples.mjs",
    "dev": "next dev --port 3001",
    "prebuild": "pnpm run build:workspace && node scripts/prepare-ort-assets.mjs && node scripts/prepare-depth-models.mjs && node scripts/ingest-examples.mjs",
    "build": "next build",
    "start": "next start --port 3001",
    "ort:assets": "node scripts/prepare-ort-assets.mjs",
    "ort:assets:check": "node scripts/prepare-ort-assets.mjs --check",
    "depth:models": "node scripts/prepare-depth-models.mjs",
    "depth:models:check": "node scripts/prepare-depth-models.mjs --check",
    "thumbs": "node scripts/render-example-thumbs.mjs --update",
    "thumbs:check": "node scripts/render-example-thumbs.mjs --check",
    "render:proof": "node scripts/render-example-thumbs.mjs --proof-dir ../../artifacts/example-renders",
    "typecheck": "tsc --noEmit",
    "check:example-imports": "node scripts/check-example-imports.mjs",
    "check:example-bundles": "node scripts/check-example-bundles.mjs",
    "build:workspace": "pnpm --dir ../.. run build"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.2.10",
    "@vercel/blob": "^2.0.0",
    "@vgpu/adapter-mock": "workspace:*",
    "@vgpu/adapter-node": "workspace:*",
    "@vgpu/cli": "workspace:*",
    "@vgpu/core": "workspace:*",
    "@vgpu/wgsl": "workspace:*",
    "@vgpu/wgsl-std": "workspace:*",
    "geist": "^1.5.1",
    "lucide-react": "^0.468.0",
    "next": "^16.2.12",
    "onnxruntime-web": "1.27.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.3",
    "remark-gfm": "^4.0.0",
    "shiki": "^3.21.0",
    "vgpu": "workspace:*"
  },
  "devDependencies": {
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@webgpu/types": "^0.1.69",
    "agentation": "^3.0.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
