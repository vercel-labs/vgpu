{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vgpu.labs.vercel.dev/schemas/examples/v1/discovery.schema.json",
  "title": "VGPU Examples Discovery",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "discoveryVersion", "contracts"],
  "properties": {
    "protocol": { "const": "vgpu-examples" },
    "discoveryVersion": { "const": 1 },
    "contracts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "schemaSha256", "status", "minimumCliVersion", "indexUrl"],
        "properties": {
          "id": { "type": "string", "pattern": "^vgpu-examples/v[1-9][0-9]*$" },
          "schemaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "status": { "enum": ["active", "deprecated", "revoked"] },
          "minimumCliVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
          "indexUrl": { "type": "string", "format": "uri" }
        }
      }
    }
  }
}
