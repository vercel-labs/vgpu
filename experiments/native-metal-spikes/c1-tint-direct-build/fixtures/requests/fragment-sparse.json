    "text": "struct FragmentInputs {\n  @builtin(position) position: vec4f,\n  @builtin(front_facing) front_facing: bool,\n  @builtin(sample_index) sample_index: u32,\n  @builtin(sample_mask) sample_mask: u32,\n  @location(2) @interpolate(linear, centroid) uv: vec2f,\n  @location(5) @interpolate(flat) tag: u32,\n  @location(6) weight: f32,\n}\n\nstruct FragmentOutputs {\n  @location(1) first: vec4f,\n  @location(4) second: vec4f,\n  @builtin(frag_depth) depth: f32,\n  @builtin(sample_mask) sample_mask: u32,\n}\n\n@fragment\nfn main(input: FragmentInputs) -> FragmentOutputs {\n  return FragmentOutputs(\n    vec4f(input.uv, input.weight, select(0.0, 1.0, input.front_facing)),\n    vec4f(f32(input.tag), f32(input.sample_index), input.position.z, 1.0),\n    input.position.z,\n    input.sample_mask,\n  );\n}\n"
  },
